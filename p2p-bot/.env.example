# Copy to .env and fill in. Never commit .env.

# --- Mode ---
# Dry-run is ON unless this is exactly "false". In dry-run the bot only reports what it would do.
DRY_RUN=

# --- Exchange ---
EXCHANGE=bybit
# Bybit API key: enable only the P2P permission (FiatP2P). Do NOT enable Withdraw. Bind it to the server IP.
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Optional, default https://api.bybit.com
BYBIT_BASE_URL=

# The ad the bot controls (Bybit ad id). Must be a fixed-price ad.
AD_ID=
# Price decimals allowed for your fiat currency (e.g. 2)
PRICE_DECIMALS=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Your personal chat id; the bot ignores everyone else.
TELEGRAM_CHAT_ID=

# --- Initial rules (can be changed later from Telegram; Telegram changes are saved in data/rules.json) ---
MIN_PRICE=
MAX_PRICE=
STEP=
MIN_CHANGE=
INTERVAL_SECONDS=
FILTER_MIN_COMPLETION_RATE=
FILTER_MIN_ORDERS=
FILTER_MIN_AD_AMOUNT=
