[Unit]
Description=P2P notification capture webhook (behind Caddy)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=p2pbot
Group=p2pbot
WorkingDirectory=/opt/p2p-bot
ExecStartPre=+/bin/sh -c 'install -d -o p2pbot -g p2pbot -m 700 /opt/p2p-bot/data'
ExecStart=/opt/p2p-bot/.venv/bin/python -m p2pbot.capture
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=-/opt/p2p-bot/data

[Install]
WantedBy=multi-user.target
